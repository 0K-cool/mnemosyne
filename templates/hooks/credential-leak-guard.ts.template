    `│${pad('  🛑 CREDENTIAL-LEAK GUARD — BLOCKED')}│`,
    '├──────────────────────────────────────────────────────────────┤',
    `│${pad('  File: ' + fileDisplay)}│`,
    `│${pad('  Matched pattern: ' + patternSource)}│`,
    `│${pad('')}│`,
    `│${pad('  Source rule: {{GENERATED_FROM}}')}│`,
    `│${pad('')}│`,
    `│${pad('  The matched secret is NOT included in this output')}│`,
    `│${pad('  or the audit log — by design.')}│`,
    `│${pad('')}│`,
