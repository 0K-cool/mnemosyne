  // credential text. Same redaction principle as PR #15 R2.
  appendAudit({ event: 'block', file_path: filePath, pattern: patternSource });
  process.exit(2);
}

function extractContent(toolName: string, input: EditInput): string | null {
  // Different tools surface the new content under different keys.
  if (toolName === 'Edit') return input.new_string ?? null;
  if (toolName === 'Write') return input.content ?? null;
  if (toolName === 'MultiEdit') {
    const edits = Array.isArray(input.edits) ? input.edits : [];
    const parts = edits.map(e => e?.new_string ?? '').filter(s => s.length > 0);
    return parts.length > 0 ? parts.join('\n') : null;
  }
  return null;
}

